// approach 3,, optimal ,, time complexity ---> O(2(m*n)), space complexity ---> O(1)

        int m = matrix.length; // m --> rows
        int n = matrix[0].length;  // n --> columns
        int row0 = 1;

        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(matrix[i][j] == 0){
                    if(j!=0){
                        matrix[0][j] = 0;
                    }
                    else{
                        row0 = 0;
                    }
                    matrix[i][0] = 0;             
                }
                
            }
        }

        for(int i=1;i<m;i++){
            for(int j=1;j<n;j++){
                if(matrix[i][j] != 0){
                    if(matrix[0][j] == 0 || matrix[i][0] == 0){
                        matrix[i][j] = 0;
                    }
                }
            }
        }

        // Finally mark the 1st col & then 1st row:
        if(matrix[0][0] == 0){
            for(int j=0;j<n;j++){
                matrix[0][j] = 0;
            }
        }
        if(row0 == 0){
            for(int i=0;i<m;i++){
                matrix[i][0] = 0;
            }
        }
    }
