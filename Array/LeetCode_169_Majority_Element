    // approach 4, Moore's voting algo, time complexity --- O(N)
    int n = nums.length;
    int count = 0;
    int element = nums[0];
    for(int i=0;i<n;i++){
        if(nums[i] == element){
            count++;
        }
        else if(count ==0){
            element = nums[i];
            count = 1;
        }
        else{
            count--;
        }
    }
    // they mentioned, there is always a majority element, so we are not going for verification
    return element;

    }
